# HTCondor Job Description File for Data NanoAOD Production
# CMSSW_15_0_15_patch4 is set up in batch space
# Output files are stored in EOS space

universe = vanilla
# SampleName will be supplied via condor_submit -append
SampleName = $(SAMPLE_NAME)
executable = run_cmsdriver_data.sh 
arguments  = $(Process) $(SampleName) $(InputFile)

# Input/Output specification - No output transfer (using EOS directly)
transfer_input_files = ./../cmsskim_customize.py, ./../MyAnalysis, ./Test_datasets/$(InputFile)


# Log, Output, and Error files (stored in AFS for monitoring)
log = logs/data_nanoaod_$(Cluster)_$(Process).log
output = logs/data_nanoaod_$(Cluster)_$(Process).out
error = logs/data_nanoaod_$(Cluster)_$(Process).err

# Resource requirements
request_cpus = 8
request_memory = 6144MB
request_disk = 20GB

# HTCondor settings
on_exit_hold = (ExitCode != 0)
on_exit_remove = (ExitCode == 0)
#periodic_remove = (time() - EnteredCurrentStatus) > (4*24*3600)

# xrootd user proxy enabling
use_x509userproxy = true

# Job priority
priority = 0
+JobFlavour = "testmatch"

queue 1
